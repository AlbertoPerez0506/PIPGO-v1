rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ivanalbertoperezramirez@gmail.com';
    }
    function isApprovedSeller(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.active == true
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.role == "seller"
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.sellerStatus == "approved";
    }
    // FIX: ahora se permite la letra ñ (y Ñ). El frontend las acepta
    // y normaliza a minúsculas antes de guardar el usernameNormalized.
    function validUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 20
        && u.matches('^[a-zA-Z0-9._ñÑ]+$');
    }
    function usernameNormalizedMatches(u, n) {
      return n is string && n.size() >= 3 && n.size() <= 20 && n == u.lower();
    }
    function validEmail(e) {
      return e is string && e.size() >= 5 && e.size() <= 200
        && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // ============================================================
    // USUARIOS
    // ============================================================
    match /usuarios/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "user"
        && request.resource.data.sellerStatus == "none"
        && request.resource.data.active == true
        && request.resource.data.admin == false
        && validUsername(request.resource.data.username)
        && usernameNormalizedMatches(request.resource.data.username, request.resource.data.usernameNormalized)
        && request.resource.data.email is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.admin == resource.data.admin
          && request.resource.data.createdAt == resource.data.createdAt
          && validUsername(request.resource.data.username)
          && usernameNormalizedMatches(request.resource.data.username, request.resource.data.usernameNormalized)
          && (
            request.resource.data.sellerStatus == resource.data.sellerStatus
            || (resource.data.sellerStatus in ["none","rejected","needs_info"]
                && request.resource.data.sellerStatus == "pending")
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["avatarUrl","updatedAt","sellerStatus","username","usernameNormalized"])
        );
      allow delete: if false;
    }

    // ============================================================
    // PERFILES PÚBLICOS
    // ============================================================
    match /perfilesPublicos/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && usernameNormalizedMatches(request.resource.data.username, request.resource.data.usernameNormalized)
        && request.resource.data.avatarUrl is string;

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && validUsername(request.resource.data.username)
          && usernameNormalizedMatches(request.resource.data.username, request.resource.data.usernameNormalized)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 "avatarUrl","username","usernameNormalized",
                 "displayName","businessName","sellerType","category",
                 "description","phone","city","state","socialUrl","contactMethod"
               ])
        );

      allow delete: if false;
    }

    // ============================================================
    // USERNAMES
    // ============================================================
    match /usernames/{normalized} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ============================================================
    // FAVORITOS
    // ============================================================
    match /usuarios/{uid}/favoritos/{publicationId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.publicationId == publicationId
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/publicaciones/$(publicationId));
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ============================================================
    // SOLICITUDES DE VENDEDOR
    // ============================================================
    match /solicitudesVendedor/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.termsAccepted == true
        && request.resource.data.sellerType in ["person", "business"]
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.businessName is string
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.state is string
        && request.resource.data.socialUrl is string
        && request.resource.data.contactMethod in ["phone", "whatsapp"]
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == null;
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && resource.data.status in ["pending", "rejected", "needs_info"]
          && request.resource.data.status in ["pending", "rejected", "needs_info"]
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.termsAccepted == true
          && request.resource.data.sellerType in ["person", "business"]
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.businessName is string
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
          && request.resource.data.city is string
          && request.resource.data.state is string
          && request.resource.data.socialUrl is string
          && request.resource.data.contactMethod in ["phone", "whatsapp"]
          && request.resource.data.submittedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null
          && request.resource.data.rejectionReason == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 "sellerType","displayName","businessName","category",
                 "description","phone","city","state","socialUrl",
                 "contactMethod","termsAccepted","status",
                 "submittedAt","updatedAt",
                 "reviewedAt","reviewedBy","rejectionReason","adminNote"
               ])
        );
      allow delete: if false;
    }

    // ============================================================
    // PUBLICACIONES
    // ============================================================
    match /publicaciones/{publicationId} {
      allow read: if
        resource.data.status == "active"
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (
          signedIn()
          && resource.data.status == "sold"
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/favoritos/$(publicationId))
        );
      allow create: if isApprovedSeller(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is string
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.mainImage is string
        && request.resource.data.mainImage.size() > 0
        && request.resource.data.images is list
        && request.resource.data.storeName is string
        && request.resource.data.phone is string
        && (!('hasWhatsapp' in request.resource.data) || request.resource.data.hasWhatsapp is bool)
        && (!('unitCode' in request.resource.data) || request.resource.data.unitCode is string)
        && (!('condition' in request.resource.data) || request.resource.data.condition is string)
        && (!('presentation' in request.resource.data)
            || request.resource.data.presentation == null
            || request.resource.data.presentation is map)
        && (!('sellerUsername' in request.resource.data) || request.resource.data.sellerUsername is string)
        && (!('sellerAvatarUrl' in request.resource.data) || request.resource.data.sellerAvatarUrl is string)
        && (!('sellerDisplayName' in request.resource.data) || request.resource.data.sellerDisplayName is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.soldAt == null;
      allow update: if isApprovedSeller(resource.data.userId)
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('hasWhatsapp' in request.resource.data) || request.resource.data.hasWhatsapp is bool)
        && (request.resource.data.sellerUsername == resource.data.sellerUsername
            || !('sellerUsername' in resource.data))
        && (request.resource.data.sellerAvatarUrl == resource.data.sellerAvatarUrl
            || !('sellerAvatarUrl' in resource.data))
        && (
          (resource.data.status == "active" && request.resource.data.status in ["active", "sold", "deleted"])
          || (resource.data.status == "sold" && request.resource.data.status == "deleted")
          || (resource.data.status == "deleted" && request.resource.data.status == "deleted")
        )
        && (
          (request.resource.data.status == "sold" && request.resource.data.soldAt is timestamp)
          || (request.resource.data.status == "active" && request.resource.data.soldAt == null)
          || (request.resource.data.status == "deleted")
        );
      allow delete: if false;
    }

    // ============================================================
    // SOLICITUDES DE RECUPERACIÓN DE CONTRASEÑA
    // ============================================================
    match /solicitudesRecuperacion/{docId} {
      allow create: if
        request.resource.data.email is string
        && validEmail(request.resource.data.email)
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.emailSentAt == null
        && request.resource.data.rejectionReason == null;

      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status','reviewedAt','reviewedBy',
               'emailSentAt','rejectionReason'
             ]);

      allow delete: if false;
    }

    // ============================================================
    // CONVERSACIONES + MENSAJES
    // ============================================================
    match /conversaciones/{conversationId} {

      function isParticipantOfExisting() {
        return signedIn()
          && resource != null
          && request.auth.uid in resource.data.participantIds;
      }

      allow read: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participantIds
      );

      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.status == 'active'
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastMessageSenderId is string
        && request.resource.data.readAtBy is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isParticipantOfExisting()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage','lastMessageAt','lastMessageSenderId',
               'lastMessageExpiresAt','updatedAt','readAtBy','status'
             ]);

      allow delete: if false;

      match /mensajes/{messageId} {
        function isConvParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(conversationId)).data.participantIds;
        }

        allow read: if isConvParticipant();

        allow create: if isConvParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in ['text','publication_context']
          && (request.resource.data.publicationId == null
              || request.resource.data.publicationId is string)
          && (request.resource.data.publicationName == null
              || request.resource.data.publicationName is string)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.edited == false
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.size() == 0;

        allow update: if isConvParticipant() && (
          // 1) Editar texto del propio mensaje
          (
            resource.data.senderId == request.auth.uid
            && !resource.data.deletedForEveryone
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text','edited','updatedAt'])
            && request.resource.data.edited == true
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
          )
          ||
          // 2) Eliminar para todos (solo autor)
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deletedForEveryone','text','updatedAt'])
            && request.resource.data.deletedForEveryone == true
          )
          ||
          // 3) Eliminar para mí (cualquier participante, solo su uid en hiddenFor)
          (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hiddenFor'])
            && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
            && request.resource.data.hiddenFor.size() == resource.data.hiddenFor.size() + 1
            && request.resource.data.hiddenFor.hasAny([request.auth.uid])
            && !(resource.data.hiddenFor.hasAny([request.auth.uid]))
          )
        );

        // Limpieza oportunista: solo se pueden borrar mensajes ya expirados.
        allow delete: if isConvParticipant()
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt <= request.time;
      }
    }
  }
}